# Shared git config, tracked in dotfiles and SYMLINKED to ~/.gitconfig.shared.
# Edits here are version controlled -- this is the file to change.
#
# ~/.gitconfig itself is a copied stub (COPY_ALWAYS in rcrc) that includes this
# file, so apps that rewrite the global config (gh, GitKraken, VSCode,
# Kaleidoscope) scribble on the disposable copy instead of on the repo.

[push]
  default = current
[color]
  ui = auto
[alias]
  aa = add --all
  ap = add --patch
  branches = for-each-ref --sort=-committerdate --format=\"%(color:blue)%(authordate:relative)\t%(color:red)%(authorname)\t%(color:white)%(color:bold)%(refname:short)\" refs/remotes
  ci = commit -v
  co = checkout
  pf = push --force-with-lease
  st = status
[core]
  excludesfile = ~/.gitignore
  autocrlf = input
	editor = code --wait
[commit]
[fetch]
  prune = true
[rebase]
  autosquash = true
[diff]
  colorMoved = zebra
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = Don Denton
	email = don@happycollision.com
[mergetool]
	keepBackup = true
[credential]
	helper = osxkeychain
[url "git@github.com:"]
	insteadOf = https://github.com/
[happy-trees]
	exec = code
