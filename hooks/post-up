#!/bin/sh

echo "Initial setup complete. Now doing post-up tasks."

# ~/.gitconfig is deliberately NOT managed by rcm -- not symlinked, not copied.
# Apps rewrite the global config constantly (gh, GitKraken, VSCode,
# Kaleidoscope); when it was a symlink into this repo those writes landed on the
# tracked file, and the --skip-worktree bit we used to hide them made it worse:
# git status called the tree clean while pulls failed with "local changes would
# be overwritten by merge".
#
# So we own exactly one line of it. The include is PREPENDED, so machine-local
# settings further down the file still override the shared config.
gitconfig_include() {
  shared="$HOME/.gitconfig.shared"
  if git config --global --get-all include.path 2>/dev/null \
     | sed "s|^~/|$HOME/|" | grep -qxF "$shared"; then
    return 0
  fi
  tmp="$HOME/.gitconfig.rcm-$$"
  printf '[include]\n\tpath = ~/.gitconfig.shared\n' > "$tmp" || return 1
  if [ -f "$HOME/.gitconfig" ]; then
    cat "$HOME/.gitconfig" >> "$tmp" || { rm -f "$tmp"; return 1; }
  fi
  mv "$tmp" "$HOME/.gitconfig" || { rm -f "$tmp"; return 1; }
  echo "Added ~/.gitconfig.shared include to ~/.gitconfig" >&2
}
gitconfig_include

if ! command -v brew &> /dev/null; then
  cat <<MSG >&2
Homebrew is not installed.
Try \`rcup' again after first installing Homebrew with

/bin/bash -c "\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install.sh)"

MSG
fi

# reset -Q

# Add mise
if ! command -v mise &> /dev/null; then
  if ! command -v brew &> /dev/null; then
    echo "Cannot install mise without brew"
  else
    echo "Installing mise"
    brew install mise
  fi
fi

# detect old OS X broken /etc/zshenv and suggest rename
if grep -qw path_helper /etc/zshenv 2>/dev/null; then
  dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)

  cat <<MSG >&2
Warning: \`/etc/zshenv' configuration file on your system may cause unexpected
PATH changes on subsequent invocations of the zsh shell. The solution is to
rename the file to \`zprofile':
  sudo mv /etc/{zshenv,zprofile}

(called from ${dir}/post-up:${LINENO})

MSG
fi
